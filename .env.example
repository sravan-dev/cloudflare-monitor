# Cloudflare API token — create at https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone > Analytics > Read  (add Zone > Zone > Read for auto zone discovery)
CF_API_TOKEN=

# Zone name (domain). Zone ID auto-discovered from this if CF_ZONE_ID empty.
CF_ZONE_NAME=tijusacademy.com

# Optional: set zone ID directly (found on the Cloudflare dashboard Overview page)
CF_ZONE_ID=

# Optional: server port (default 3000)
PORT=3000
