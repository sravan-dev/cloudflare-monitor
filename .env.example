# Cloudflare API token — create at https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone > Analytics > Read  (add Zone > Zone > Read for auto zone discovery)
CF_API_TOKEN=

# Zone name (domain). Zone ID auto-discovered from this if CF_ZONE_ID empty.
CF_ZONE_NAME=tijusacademy.com

# Optional: set zone ID directly (found on the Cloudflare dashboard Overview page)
CF_ZONE_ID=

# Optional: server port (default 3000)
PORT=3000

# Optional: protect the dashboard with HTTP Basic auth (username: admin).
# Strongly recommended for public deployments. Leave empty for local use.
DASHBOARD_PASSWORD=

# ---- 5xx email alerts ----
# Comma-separated recipients. Leave empty to disable alerting.
ALERT_EMAIL_TO=
# Gmail address + 16-character app password (https://myaccount.google.com/apppasswords).
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Poll interval, 5xx count that triggers an alert, and minutes before re-alerting.
ALERT_INTERVAL_SEC=60
ALERT_5XX_THRESHOLD=1
ALERT_COOLDOWN_MIN=30
